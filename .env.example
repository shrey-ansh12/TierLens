# ==============================================================================
# TierLens Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=tierlens_super_secret_jwt_key_replace_in_production_2026_xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Configuration
POSTGRES_USER=tierlens
POSTGRES_PASSWORD=tierlens_secure_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tierlens_db
DATABASE_URL=postgresql+asyncpg://tierlens:tierlens_secure_pass@localhost:5432/tierlens_db
SYNC_DATABASE_URL=postgresql+psycopg2://tierlens:tierlens_secure_pass@localhost:5432/tierlens_db

# Fallback SQLite DB for local execution without Docker:
# Set to True to allow automatic fallback to SQLite when PostgreSQL is offline
SQLITE_FALLBACK_ENABLED=True
SQLITE_DATABASE_URL=sqlite+aiosqlite:///./tierlens.db
SQLITE_SYNC_DATABASE_URL=sqlite:///./tierlens.db

# Neo4j Graph Database
# For local Docker: bolt://localhost:7687
# For Neo4j AuraDB (Cloud): neo4j+ssc://<instance-id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tierlens_graph_pass

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI / LLM Configuration
# Optional: Set Gemini or OpenAI API key for evidence-grounded AI root cause explanations.
# If omitted, TierLens seamlessly uses the built-in deterministic rule-based analysis engine.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Android SDK & ADB Configuration (Host paths)
ANDROID_HOME=C:\Users\shrey\AppData\Local\Android\Sdk
ADB_PATH=adb

# Artifacts & Storage
ARTIFACTS_DIR=./artifacts
MAX_UPLOAD_SIZE_MB=150

# Frontend URL (for CORS)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000
